<Project>                                                       
    <PropertyGroup>                                               
      <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>                                                       
    </PropertyGroup>                                              
    <ItemGroup>                                                   
      <PackageVersion Include="xunit.v3" Version="3.2.2" />       
      <PackageVersion Include="FSharp.Core" Version="10.1.301" /> 
      <PackageVersion Include="FSharp.UMX" Version="1.1.0" />
      <PackageVersion Include="FsToolkit.ErrorHandling" Version="5.2.0" />
      <PackageVersion Include="MongoDB.Driver" Version="3.9.0" />
      <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
      <PackageVersion Include="Oxpecker" Version="2.0.1" />
      <PackageVersion Include="Oxpecker.OpenApi" Version="2.1.2" />
      <!-- Pin patched version of Microsoft.OpenApi to override the vulnerable 2.0.0 pulled in transitively by Oxpecker.OpenApi (https://github.com/advisories/GHSA-v5pm-xwqc-g5wc) -->
      <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
      <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.7" />
      <PackageVersion Include="coverlet.collector" Version="6.0.4"/>
      <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
      <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
      <PackageVersion Include="Testcontainers.MongoDb" Version="4.12.0" />
      <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4"/>
      <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
      <!-- ...one line per package, the single source of truth for
  versions -->                                                    
    </ItemGroup>                                                  
  </Project>