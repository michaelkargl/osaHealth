# MongoDB
MONGO_ROOT_USER=changeme
MONGO_ROOT_PASSWORD=changeme

# MongoDB Admin Interface
MONGOEXPRESS_ROOT_USER=changeme
MONGOEXPRESS_ROOT_PASSWORD=changeme

# HashiCorp Vault — populated on first run (see README: First-run setup)
VAULT_UNSEAL_KEY=
VAULT_ROOT_TOKEN=

# Grafana — defaults to "admin" when not set
GRAFANA_ADMIN_PASSWORD=changeme

# Hindsight
# https://hindsight.vectorize.io/developer/configuration#llm-provider
HINDSIGHT_API_DATA_VOLUME=~/hindsight/.hindsight-docker
HINDSIGHT_API_LLM_API_KEY=sk-76828f55-6030-434b-8b7c-077fc7d27bd8
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_MODEL=deepseek-v4-flash