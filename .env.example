# MongoDB
MONGO_ROOT_USER=changeme
MONGO_ROOT_PASSWORD=changeme
# MongoDB Admin Interface
MONGOEXPRESS_ROOT_USER=changeme
MONGOEXPRESS_ROOT_PASSWORD=changeme
# HashiCorp Vault — populated on first run (see README: First-run setup)
VAULT_UNSEAL_KEY=
VAULT_ROOT_TOKEN=
# Grafana — defaults to "admin" when not set
GRAFANA_ADMIN_PASSWORD=changeme
