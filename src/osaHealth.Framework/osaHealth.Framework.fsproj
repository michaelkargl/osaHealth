<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latestmajor</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Library.fs"/>
        <Compile Include="Json.fs" />
        <Compile Include="StringUtil.fs" />
        <Compile Include="Api.fs" />
        <Compile Include="Dapr.fs" />
        <Compile Include="Testing\Bdd.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.UMX" Version="1.1.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- TODO: remove once .NET 11 stable SDK ships with a fixed FSharp.Core by default -->
        <PackageReference Update="FSharp.Core" Version="11.0.101-preview4.26230.115" />
    </ItemGroup>

</Project>
